{
  "name": "@ai-safety-governance/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "22.18.0",
    "pnpm": "10.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "msw"
    ]
  },
  "scripts": {
    "prepare:fonts": "node scripts/prepare-fonts.mjs",
    "dev": "pnpm run prepare:fonts && vite",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "pnpm run prepare:fonts && vitest",
    "test:run": "pnpm run prepare:fonts && vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm run prepare:fonts && tsc -b && vite build"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.6",
    "@tanstack/react-query": "5.85.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.8.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@typescript-eslint/eslint-plugin": "8.41.0",
    "@typescript-eslint/parser": "8.41.0",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "8.57.1",
    "jsdom": "26.1.0",
    "msw": "2.11.1",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "es2022": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "ignorePatterns": [
      "dist/",
      "node_modules/",
      "playwright-report/",
      "test-results/"
    ]
  }
}
